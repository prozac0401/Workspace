<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="보이는 칸 붙여넣기" Manufacturer="Workspace" Version="$(var.ProductVersion)" ProductCode="$(var.ProductCode)" UpgradeCode="$(var.UpgradeCode)" Language="1042" Codepage="65001" Scope="perUser" InstallerVersion="500">
    <SummaryInformation Description="보이는 칸 붙여넣기 $(var.DisplayVersion) ($(var.Architecture))" Manufacturer="Workspace" Codepage="949" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Upgrade Id="$(var.UpgradeCode)"><UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" OnlyDetect="yes" Property="VCPRELATED" /></Upgrade>
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="VcpDeferred" Hidden="yes" />
    <Property Id="VCPCODEBASE" Hidden="yes" />
    <Property Id="SAVEDINSTALLFOLDER"><RegistrySearch Id="PreviousMsiPath" Root="HKCU" Key="Software\Workspace\VisibleCellsPasteMsi" Name="InstallFolder" Type="raw" Bitness="$(var.Bitness)" /></Property>
    <SetProperty Id="INSTALLFOLDER" Value="[SAVEDINSTALLFOLDER]" After="AppSearch" Sequence="both" Condition="SAVEDINSTALLFOLDER AND NOT INSTALLFOLDER" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />
    <Launch Condition="NOT ALLUSERS" Message="현재 로그인한 사용자 전용 설치입니다. PC 전체 설치 옵션은 지원하지 않습니다." />
    <Binary Id="VcpGuard" SourceFile="$(var.GuardDll)" />
    <CustomAction Id="VcpPreflight" BinaryRef="VcpGuard" DllEntry="VcpPreflight" Execute="immediate" Return="check" />
    <CustomAction Id="VcpDeferred" BinaryRef="VcpGuard" DllEntry="VcpDeferred" Execute="deferred" Impersonate="yes" Return="check" HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="VcpPreflight" Before="InstallInitialize" />
      <Custom Action="VcpDeferred" After="InstallInitialize" />
    </InstallExecuteSequence>
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="ProgramsFolder" Name="Programs"><Directory Id="INSTALLFOLDER" Name="VisibleCellsPaste" /></Directory></StandardDirectory>
    <Feature Id="Product" Title="보이는 칸 붙여넣기" Level="1"><ComponentRef Id="AddInProduct" /><ComponentGroupRef Id="ApplicationFiles" /></Feature>
    <?if $(var.RollbackTest) = 1 ?>
      <!-- Developer-only candidate, never included in released MSI packages. -->
      <CustomAction Id="FailRollbackTest" Error="VisibleCellsPaste local rollback test after standard installation actions." />
      <InstallExecuteSequence><Custom Action="FailRollbackTest" After="InstallExecute" Condition="NOT REMOVE" /></InstallExecuteSequence>
    <?endif?>
    <UI>
      <TextStyle Id="DefaultFont" FaceName="Malgun Gothic" Size="9" />
      <Property Id="DefaultUIFont" Value="DefaultFont" />
      <Dialog Id="Welcome" Width="430" Height="300" Title="보이는 칸 붙여넣기 설치">
        <Control Id="Body" Type="Text" X="24" Y="24" Width="382" Height="200" Text="선택한 영역의 보이는 행과 열에 복사한 값을 순서대로 붙여넣습니다.&#13;&#10;원본과 대상의 보이는 행 수·열 수가 같아야 합니다.&#13;&#10;&#13;&#10;현재 Windows 사용자에게 설치하며 관리자 권한은 필요하지 않습니다.&#13;&#10;Excel 작업을 저장하고 모든 Excel 창을 닫아 주세요.&#13;&#10;기존 ZIP/Setup 설치가 있으면 Windows 설정에서 먼저 제거해 주세요.&#13;&#10;&#13;&#10;버전: $(var.DisplayVersion) / Excel $(var.Architecture)&#13;&#10;설치 위치: [INSTALLFOLDER]" />
        <Control Id="Install" Type="PushButton" X="240" Y="251" Width="76" Height="24" Default="yes" Text="설치"><Publish Event="EndDialog" Value="Return" /></Control>
        <Control Id="Cancel" Type="PushButton" X="326" Y="251" Width="76" Height="24" Cancel="yes" Text="취소"><Publish Event="EndDialog" Value="Exit" /></Control>
      </Dialog>
      <Dialog Id="Maintenance" Width="430" Height="250" Title="보이는 칸 붙여넣기 복구 또는 제거">
        <Control Id="Body" Type="Text" X="24" Y="24" Width="382" Height="150" Text="프로그램 파일과 추가 기능 등록을 복구하거나 제거합니다.&#13;&#10;Excel 작업을 저장하고 모든 Excel 창을 닫아 주세요.&#13;&#10;&#13;&#10;외부에서 변경한 프로그램 파일·등록·로드 설정이 있으면 보존을 위해 중단합니다.&#13;&#10;사용자 통합문서와 추가한 파일은 그대로 둡니다.&#13;&#10;&#13;&#10;복구해도 조직의 보안 설정이나 차단 정책은 변경하지 않습니다." />
        <Control Id="Repair" Type="PushButton" X="114" Y="201" Width="96" Height="24" Default="yes" Text="복구"><Publish Property="REINSTALL" Value="ALL" /><Publish Property="REINSTALLMODE" Value="amus" /><Publish Event="EndDialog" Value="Return" /></Control>
        <Control Id="Remove" Type="PushButton" X="220" Y="201" Width="96" Height="24" Text="제거"><Publish Property="REMOVE" Value="ALL" /><Publish Event="EndDialog" Value="Return" /></Control>
        <Control Id="Cancel" Type="PushButton" X="326" Y="201" Width="76" Height="24" Cancel="yes" Text="취소"><Publish Event="EndDialog" Value="Exit" /></Control>
      </Dialog>
      <Dialog Id="Complete" Width="430" Height="200" Title="보이는 칸 붙여넣기">
        <Control Id="Body" Type="Text" X="24" Y="24" Width="382" Height="120" Text="설치 작업을 마쳤습니다.&#13;&#10;&#13;&#10;설치 후 Excel을 평소처럼 실행해 주세요.&#13;&#10;복사 → 대상 영역 선택 → 우클릭 → 보이는 칸에 붙여넣기&#13;&#10;&#13;&#10;제거한 경우 다음 Excel 실행부터 자체 메뉴가 표시되지 않습니다." />
        <Control Id="Close" Type="PushButton" X="326" Y="151" Width="76" Height="24" Default="yes" Cancel="yes" Text="닫기"><Publish Event="EndDialog" Value="Return" /></Control>
      </Dialog>
      <InstallUISequence><Show Dialog="Welcome" Before="Maintenance" Condition="NOT Installed" /><Show Dialog="Maintenance" Before="ExecuteAction" Condition="Installed AND NOT REMOVE AND NOT REINSTALL" /><Show Dialog="Complete" OnExit="success" /></InstallUISequence>
    </UI>
  </Package>
</Wix>
