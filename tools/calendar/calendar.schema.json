{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workspace:calendar:1",
  "title": "Workspace public calendar dataset v1",
  "description": "Run contract.mjs as well: it validates real dates, year/key matching, ordering, completeness, raw counts, production fixture restrictions and the 2 MiB canonical UTF-8 JSON size limit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "datasetKind", "supportedYears", "targetYears", "years"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "operation", "url"],
      "properties": {
        "provider": { "const": "KASI" },
        "operation": { "const": "getRestDeInfo" },
        "url": { "const": "https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService/getRestDeInfo" }
      }
    },
    "datasetKind": { "enum": ["official", "fixture", "uninitialized"] },
    "supportedYears": { "$ref": "#/$defs/yearPair" },
    "targetYears": { "$ref": "#/$defs/yearPair" },
    "years": {
      "type": "object", "minProperties": 2, "maxProperties": 2, "additionalProperties": false,
      "patternProperties": { "^(19[0-9]{2}|20[0-9]{2}|2100)$": { "$ref": "#/$defs/year" } }
    }
  },
  "$defs": {
    "yearPair": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "integer", "minimum": 1900, "maximum": 2100 } },
    "text": { "type": "string", "minLength": 1, "maxLength": 250, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
    "month": {
      "type": "object", "additionalProperties": false,
      "required": ["month", "rawCount", "pages", "status"],
      "properties": {
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "rawCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "pages": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "status": { "enum": ["success", "unavailable", "error"] }
      }
    },
    "holiday": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "name", "source", "category", "sourceId"],
      "properties": {
        "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
        "source": { "const": "official" },
        "category": { "const": "public" },
        "sourceId": { "type": "string", "pattern": "^kasi:[0-9]{8}:[0-9]{1,6}$", "maxLength": 20 }
      }
    },
    "year": {
      "type": "object", "additionalProperties": false,
      "required": ["year", "status", "complete", "lastSuccessfulFetchAt", "snapshotId", "monthResults", "holidays", "warnings"],
      "properties": {
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "status": { "enum": ["ready", "preserved", "unavailable", "error"] },
        "complete": { "type": "boolean" },
        "lastSuccessfulFetchAt": { "type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        "snapshotId": { "type": ["string", "null"], "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 100 },
        "monthResults": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/$defs/month" } },
        "holidays": { "type": "array", "maxItems": 12000, "items": { "$ref": "#/$defs/holiday" } },
        "warnings": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/text" } }
      },
      "allOf": [{
        "if": { "properties": { "complete": { "const": true } } },
        "then": { "properties": {
          "status": { "enum": ["ready", "preserved"] },
          "lastSuccessfulFetchAt": { "type": "string" }, "snapshotId": { "type": "string", "minLength": 1 },
          "holidays": { "minItems": 1 },
          "monthResults": { "items": { "properties": { "status": { "const": "success" }, "pages": { "minimum": 1 } } } }
        } },
        "else": { "properties": {
          "status": { "enum": ["unavailable", "error"] },
          "lastSuccessfulFetchAt": { "const": null }, "snapshotId": { "const": null }, "holidays": { "maxItems": 0 },
          "monthResults": { "items": { "properties": { "status": { "enum": ["unavailable", "error"] }, "pages": { "const": 0 }, "rawCount": { "const": 0 } } } }
        } }
      }]
    }
  }
}
