{
  "manifest_version": 3,
  "name": "DownloadVersionManager (평가판)",
  "version": "0.1.0",
  "description": "가장 최근에 받은 파일에 원래 이름을 주고, 내용이 달라진 이전 파일만 보관합니다.",
  "key": "",
  "permissions": ["downloads", "storage", "nativeMessaging", "notifications"],
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "action": {"default_title": "DownloadVersionManager 연결 확인", "default_popup": "popup.html"}
}
