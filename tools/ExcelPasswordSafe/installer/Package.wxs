<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ExcelPasswordSafe" Manufacturer="Workspace" Version="$(var.Version)" UpgradeCode="0E60B57C-21DA-41A5-8FAC-6CCDF41EB62C" Language="1042" Codepage="65001" Scope="perUser" InstallerVersion="500">
    <SummaryInformation Description="Excel 암호 관리 설치 파일 · 평가용" Keywords="Excel, 암호, 설치" Manufacturer="Workspace" Codepage="949"/>
    <MajorUpgrade DowngradeErrorMessage="더 새로운 ExcelPasswordSafe가 이미 설치되어 있습니다." Schedule="afterInstallInitialize"/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
    <Property Id="WINDOWSBUILD"><RegistrySearch Id="WindowsCurrentBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64"/></Property>
    <Property Id="NETFRAMEWORKRELEASE"><RegistrySearch Id="NetFrameworkRelease" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" Bitness="always64"/></Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 19041)" Message="Windows 10 (2004) 이상을 사용하는 x64 PC가 필요합니다."/>
    <Launch Condition="Installed OR NETFRAMEWORKRELEASE &gt;= &quot;#528040&quot;" Message="Windows .NET Framework 4.8 이상이 필요합니다. Windows 업데이트 후 다시 설치하세요."/>
    <Property Id="SAVEDINSTALLFOLDER"><RegistrySearch Id="RememberedInstallFolder" Root="HKCU" Key="Software\Workspace\ExcelPasswordSafe" Name="InstallFolder" Type="raw"/></Property>
    <SetProperty Id="INSTALLFOLDER" Value="[SAVEDINSTALLFOLDER]" After="AppSearch" Sequence="both" Condition="SAVEDINSTALLFOLDER AND NOT INSTALLFOLDER"/>
    <Property Id="ARPCOMMENTS" Value="Excel 열기 암호 설정·해제·변경. 데스크톱 Excel 필요. 서명되지 않은 평가 패키지."/>
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="ProgramsFolder" Name="Programs"><Directory Id="INSTALLFOLDER" Name="ExcelPasswordSafe"><Directory Id="RUNTIMEDIR" Name="runtime"/></Directory></Directory></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="SHORTCUTFOLDER" Name="ExcelPasswordSafe"/></StandardDirectory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallLocation" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\Workspace\ExcelPasswordSafe" Name="InstallFolder" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes"/>
        <RemoveFolder Id="RemoveRuntimeFolder" Directory="RUNTIMEDIR" On="uninstall"/>
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall"/>
      </Component>
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenu" Directory="SHORTCUTFOLDER" Name="Excel 암호 관리" Target="[INSTALLFOLDER]ExcelPasswordSafe.exe" WorkingDirectory="INSTALLFOLDER"/>
        <RegistryValue Root="HKCU" Key="Software\Workspace\ExcelPasswordSafe" Name="Shortcut" Type="integer" Value="1" KeyPath="yes"/>
        <RemoveFolder Id="RemoveShortcutFolder" Directory="SHORTCUTFOLDER" On="uninstall"/>
      </Component>
    </DirectoryRef>
    <Feature Id="Main" Title="Excel 암호 관리" Level="1"><ComponentGroupRef Id="ApplicationFiles"/><ComponentGroupRef Id="ExplorerCommands"/><ComponentRef Id="InstallLocation"/><ComponentRef Id="StartMenuShortcut"/></Feature>
    <UI>
      <TextStyle Id="DefaultFont" FaceName="Malgun Gothic" Size="9"/>
      <TextStyle Id="TitleFont" FaceName="Malgun Gothic" Size="17" Bold="yes"/>
      <TextStyle Id="BrandFont" FaceName="Malgun Gothic" Size="9" Bold="yes" Red="54" Green="89" Blue="217"/>
      <TextStyle Id="SecondaryFont" FaceName="Malgun Gothic" Size="9" Red="80" Green="95" Blue="115"/>
      <Property Id="DefaultUIFont" Value="DefaultFont"/>
      <Dialog Id="Welcome" Width="460" Height="342" Title="Excel 암호 관리 설치">
        <Control Id="Brand" Type="Text" X="28" Y="20" Width="400" Height="16" Text="{\BrandFont}ExcelPasswordSafe · [ProductVersion]"/>
        <Control Id="Title" Type="Text" X="28" Y="43" Width="400" Height="34" Text="{\TitleFont}Excel 암호 관리 설치"/>
        <Control Id="Subtitle" Type="Text" X="28" Y="82" Width="400" Height="20" Text="{\SecondaryFont}파일의 열기 암호를 설정·해제·변경합니다."/>
        <Control Id="HeaderLine" Type="Line" X="28" Y="111" Width="404" Height="1"/>
        <Control Id="Body" Type="Text" X="28" Y="128" Width="400" Height="49" Text="현재 Windows 계정에 설치합니다. 관리자 권한은 필요하지 않습니다.&#13;&#10;데스크톱 Microsoft Excel이 설치되어 있어야 합니다.&#13;&#10;&#13;&#10;Windows 11: 파일 우클릭 → 더 많은 옵션 표시 → Excel 암호 관리"/>
        <Control Id="Folder" Type="Text" X="28" Y="192" Width="400" Height="48" Text="{\SecondaryFont}설치 위치&#13;&#10;[INSTALLFOLDER]"/>
        <Control Id="Evaluation" Type="Text" X="28" Y="254" Width="400" Height="20" Text="서명되지 않은 평가용 패키지입니다."/>
        <Control Id="FooterLine" Type="Line" X="28" Y="288" Width="404" Height="1"/>
        <Control Id="Install" Type="PushButton" X="248" Y="302" Width="88" Height="26" Default="yes" Text="설치"><Publish Event="EndDialog" Value="Return"/></Control>
        <Control Id="Cancel" Type="PushButton" X="344" Y="302" Width="88" Height="26" Cancel="yes" Text="취소"><Publish Event="EndDialog" Value="Exit"/></Control>
      </Dialog>
      <Dialog Id="Progress" Width="460" Height="230" Title="Excel 암호 관리 작업 중" Modeless="yes">
        <Control Id="Brand" Type="Text" X="28" Y="20" Width="400" Height="16" Text="{\BrandFont}ExcelPasswordSafe · [ProductVersion]"/>
        <Control Id="Title" Type="Text" X="28" Y="43" Width="400" Height="34" TabSkip="no" Text="{\TitleFont}잠시 기다려 주세요"/>
        <Control Id="HeaderLine" Type="Line" X="28" Y="95" Width="404" Height="1"/>
        <Control Id="Action" Type="Text" X="28" Y="114" Width="400" Height="42"><Subscribe Event="ActionText" Attribute="Text"/></Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="28" Y="170" Width="404" Height="16" ProgressBlocks="yes"><Subscribe Event="SetProgress" Attribute="Progress"/></Control>
      </Dialog>
      <Dialog Id="Maintenance" Width="460" Height="286" Title="Excel 암호 관리 복구 또는 제거">
        <Control Id="Brand" Type="Text" X="28" Y="20" Width="400" Height="16" Text="{\BrandFont}ExcelPasswordSafe · [ProductVersion]"/>
        <Control Id="Title" Type="Text" X="28" Y="43" Width="400" Height="34" Text="{\TitleFont}복구 또는 제거"/>
        <Control Id="HeaderLine" Type="Line" X="28" Y="95" Width="404" Height="1"/>
        <Control Id="Body" Type="Text" X="28" Y="114" Width="400" Height="93" Text="프로그램 복구&#13;&#10;프로그램 파일과 탐색기 메뉴를 다시 설치합니다.&#13;&#10;&#13;&#10;프로그램 제거&#13;&#10;프로그램과 메뉴를 지웁니다. Excel 파일·백업·복구 기록은 보존합니다."/>
        <Control Id="FooterLine" Type="Line" X="28" Y="232" Width="404" Height="1"/>
        <Control Id="Repair" Type="PushButton" X="126" Y="246" Width="96" Height="26" Default="yes" Text="프로그램 복구"><Publish Property="REINSTALL" Value="ALL"/><Publish Property="REINSTALLMODE" Value="amus"/><Publish Event="EndDialog" Value="Return"/></Control>
        <Control Id="Remove" Type="PushButton" X="230" Y="246" Width="96" Height="26" Text="프로그램 제거"><Publish Property="REMOVE" Value="ALL"/><Publish Event="EndDialog" Value="Return"/></Control>
        <Control Id="Cancel" Type="PushButton" X="334" Y="246" Width="98" Height="26" Cancel="yes" Text="취소"><Publish Event="EndDialog" Value="Exit"/></Control>
      </Dialog>
      <Dialog Id="Complete" Width="460" Height="286" Title="Excel 암호 관리">
        <Control Id="Brand" Type="Text" X="28" Y="20" Width="400" Height="16" Text="{\BrandFont}ExcelPasswordSafe · [ProductVersion]"/>
        <Control Id="Title" Type="Text" X="28" Y="43" Width="400" Height="34" Text="{\TitleFont}작업을 마쳤습니다"/>
        <Control Id="HeaderLine" Type="Line" X="28" Y="95" Width="404" Height="1"/>
        <Control Id="Body" Type="Text" X="28" Y="114" Width="400" Height="93" Text="설치·복구 후 Excel 파일을 오른쪽 클릭하세요.&#13;&#10;Windows 11: 더 많은 옵션 표시 → Excel 암호 관리&#13;&#10;시작 메뉴에서도 프로그램을 열 수 있습니다.&#13;&#10;&#13;&#10;제거해도 Excel 파일과 백업, 복구 기록은 남아 있습니다."/>
        <Control Id="FooterLine" Type="Line" X="28" Y="232" Width="404" Height="1"/>
        <Control Id="Close" Type="PushButton" X="344" Y="246" Width="88" Height="26" Default="yes" Cancel="yes" Text="닫기"><Publish Event="EndDialog" Value="Return"/></Control>
      </Dialog>
      <InstallUISequence><Show Dialog="Welcome" Before="Maintenance" Condition="NOT Installed"/><Show Dialog="Maintenance" Before="Progress" Condition="Installed AND NOT REMOVE AND NOT REINSTALL"/><Show Dialog="Progress" Before="ExecuteAction"/><Show Dialog="Complete" OnExit="success"/></InstallUISequence>
    </UI>
  </Package>
</Wix>
