<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ExcelPasswordSafe $(var.DisplayVersion)" Manufacturer="Workspace" Version="$(var.Version)" UpgradeCode="0E60B57C-21DA-41A5-8FAC-6CCDF41EB62C" Language="1042" Codepage="65001" Scope="perUser" InstallerVersion="500">
    <SummaryInformation Description="Excel 암호 관리 $(var.DisplayVersion) 설치 파일" Keywords="Excel, 암호, 설치" Manufacturer="Workspace" Codepage="949"/>
    <MajorUpgrade DowngradeErrorMessage="더 새로운 ExcelPasswordSafe가 이미 설치되어 있습니다." Schedule="afterInstallInitialize"/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
    <Property Id="WINDOWSBUILD"><RegistrySearch Id="WindowsCurrentBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64"/></Property>
    <Property Id="NETFRAMEWORKRELEASE"><RegistrySearch Id="NetFrameworkRelease" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" Bitness="always64"/></Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 19041)" Message="Windows 10 (2004) 이상을 사용하는 x64 PC가 필요합니다."/>
    <Launch Condition="Installed OR NETFRAMEWORKRELEASE &gt;= &quot;#528040&quot;" Message="Windows .NET Framework 4.8 이상이 필요합니다. Windows 업데이트 후 다시 설치하세요."/>
    <Property Id="SAVEDINSTALLFOLDER"><RegistrySearch Id="RememberedInstallFolder" Root="HKCU" Key="Software\Workspace\ExcelPasswordSafe" Name="InstallFolder" Type="raw"/></Property>
    <SetProperty Id="INSTALLFOLDER" Value="[SAVEDINSTALLFOLDER]" After="AppSearch" Sequence="both" Condition="SAVEDINSTALLFOLDER"/>
    <Property Id="ARPCOMMENTS" Value="Excel 파일과 폴더의 열기 암호 설정·해제·변경. 데스크톱 Excel 필요."/>
    <Icon Id="ExcelPasswordSafe.ico" SourceFile="$(var.IconPath)"/>
    <Binary Id="AppIcon" SourceFile="$(var.IconPath)"/>
    <Property Id="ARPPRODUCTICON" Value="ExcelPasswordSafe.ico"/>
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute"/>
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="ProgramsFolder" Name="Programs"><Directory Id="INSTALLFOLDER" Name="ExcelPasswordSafe"><Directory Id="RUNTIMEDIR" Name="runtime"/></Directory></Directory></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="SHORTCUTFOLDER" Name="ExcelPasswordSafe"/></StandardDirectory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallLocation" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\Workspace\ExcelPasswordSafe" Name="InstallFolder" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes"/>
        <RemoveFolder Id="RemoveRuntimeFolder" Directory="RUNTIMEDIR" On="uninstall"/>
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall"/>
      </Component>
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenu" Directory="SHORTCUTFOLDER" Name="Excel 암호 관리" Target="[INSTALLFOLDER]ExcelPasswordSafe.exe" WorkingDirectory="INSTALLFOLDER" Icon="ExcelPasswordSafe.ico" IconIndex="0"/>
        <RegistryValue Root="HKCU" Key="Software\Workspace\ExcelPasswordSafe" Name="Shortcut" Type="integer" Value="1" KeyPath="yes"/>
        <RemoveFolder Id="RemoveShortcutFolder" Directory="SHORTCUTFOLDER" On="uninstall"/>
      </Component>
    </DirectoryRef>
    <Feature Id="Main" Title="Excel 암호 관리" Level="1"><ComponentGroupRef Id="ApplicationFiles"/><ComponentGroupRef Id="ExplorerCommands"/><ComponentRef Id="InstallLocation"/><ComponentRef Id="StartMenuShortcut"/></Feature>
    <UI>
      <TextStyle Id="DefaultFont" FaceName="Malgun Gothic" Size="9"/>
      <TextStyle Id="TitleFont" FaceName="Malgun Gothic" Size="17" Bold="yes"/>
      <TextStyle Id="BrandFont" FaceName="Malgun Gothic" Size="9" Bold="yes" Red="54" Green="89" Blue="217"/>
      <TextStyle Id="SecondaryFont" FaceName="Malgun Gothic" Size="9" Red="80" Green="95" Blue="115"/>
      <Property Id="DefaultUIFont" Value="DefaultFont"/>
      <Property Id="ErrorDialog" Value="InstallerError"/>
      <Error Id="1303" Message="이 폴더에 접근할 권한이 없습니다: [2]. 현재 계정에서 쓸 수 있는 다른 설치 폴더를 선택하세요."/>
      <Error Id="1312" Message="같은 이름의 파일이 있어 폴더를 만들 수 없습니다: [2]. 다른 설치 폴더를 선택하세요."/>
      <Error Id="1313" Message="선택한 드라이브를 사용할 수 없습니다: [2]. 사용 가능한 드라이브의 폴더를 선택하세요."/>
      <Error Id="1314" Message="설치 경로를 사용할 수 없습니다: [2]. 경로를 확인하거나 찾아보기에서 다른 폴더를 선택하세요."/>
      <Error Id="1315" Message="이 폴더에 파일을 쓸 수 없습니다: [2]. 현재 계정에서 쓸 수 있는 폴더를 선택하세요."/>
      <Error Id="1317" Message="설치 폴더를 만들 수 없습니다: [2]. 현재 계정에서 쓸 수 있는 다른 폴더를 선택하세요."/>
      <Error Id="1320" Message="설치 경로가 너무 깁니다: [2]. 더 짧은 폴더 경로를 선택하세요."/>
      <Error Id="1322" Message="설치 경로가 올바르지 않습니다: [2]. 폴더 이름을 확인하거나 찾아보기를 사용하세요."/>
      <Error Id="1323" Message="설치 폴더 이름을 사용할 수 없습니다: [2]. 다른 이름을 입력하세요."/>
      <Error Id="1324" Message="설치 경로에 사용할 수 없는 문자가 있습니다: [2]. 폴더 이름을 확인하거나 찾아보기를 사용하세요."/>
      <Error Id="1325" Message="설치 폴더 이름이 올바르지 않습니다: [2]. 폴더 이름을 확인하거나 찾아보기를 사용하세요."/>
      <Error Id="1327" Message="선택한 드라이브가 올바르지 않습니다: [2]. 찾아보기에서 사용 가능한 폴더를 선택하세요."/>
      <Dialog Id="Welcome" Width="460" Height="358" Title="Excel 암호 관리 $(var.DisplayVersion) 설치">
        <Control Id="Brand" Type="Text" X="28" Y="20" Width="350" Height="16" Text="{\BrandFont}ExcelPasswordSafe $(var.DisplayVersion)"/>
        <Control Id="AppIcon" Type="Icon" X="392" Y="21" Width="32" Height="32" IconSize="32" FixedSize="yes" Text="AppIcon"/>
        <Control Id="Title" Type="Text" X="28" Y="43" Width="350" Height="34" Text="{\TitleFont}Excel 암호 관리 설치"/>
        <Control Id="Subtitle" Type="Text" X="28" Y="82" Width="400" Height="20" Text="{\SecondaryFont}파일·폴더·폴더의 빈 공간에서 암호 관리를 시작하세요."/>
        <Control Id="HeaderLine" Type="Line" X="28" Y="111" Width="404" Height="1"/>
        <Control Id="Body" Type="Text" X="28" Y="126" Width="400" Height="39" Text="현재 Windows 계정에 설치합니다. 관리자 권한은 필요하지 않습니다.&#13;&#10;데스크톱 Microsoft Excel이 설치되어 있어야 합니다."/>
        <Control Id="FolderLabel" Type="Text" X="28" Y="180" Width="400" Height="15" TabSkip="no" Text="설치 위치"/>
        <Control Id="FolderPath" Type="PathEdit" X="28" Y="200" Width="306" Height="22" Property="INSTALLFOLDER" DisableCondition="SAVEDINSTALLFOLDER"/>
        <Control Id="Browse" Type="PushButton" X="342" Y="198" Width="90" Height="26" Text="찾아보기…" DisableCondition="SAVEDINSTALLFOLDER"><Publish Event="SpawnDialog" Value="BrowseFolder"/></Control>
        <Control Id="FolderHelp" Type="Text" X="28" Y="234" Width="400" Height="42" Text="{\SecondaryFont}현재 계정에서 쓸 수 있는 폴더를 선택하세요.&#13;&#10;기존 설치를 업데이트할 때는 설치 위치를 유지합니다."/>
        <Control Id="FooterLine" Type="Line" X="28" Y="304" Width="404" Height="1"/>
        <Control Id="Install" Type="PushButton" X="248" Y="318" Width="88" Height="26" Default="yes" Text="설치">
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1" Condition="NOT SAVEDINSTALLFOLDER AND NOT Installed"/>
          <Publish Event="EndDialog" Value="Return" Order="2"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="344" Y="318" Width="88" Height="26" Cancel="yes" Text="취소"><Publish Event="EndDialog" Value="Exit"/></Control>
      </Dialog>
      <Dialog Id="BrowseFolder" Width="460" Height="370" Title="설치 폴더 선택">
        <Control Id="Title" Type="Text" X="28" Y="20" Width="400" Height="28" Text="{\TitleFont}설치 폴더 선택"/>
        <Control Id="LocationLabel" Type="Text" X="28" Y="61" Width="400" Height="14" TabSkip="no" Text="드라이브와 폴더"/>
        <Control Id="Drives" Type="DirectoryCombo" X="28" Y="82" Width="238" Height="100" Property="INSTALLFOLDER" Fixed="yes"><Subscribe Event="IgnoreChange" Attribute="IgnoreChange"/></Control>
        <Control Id="Up" Type="PushButton" X="276" Y="80" Width="72" Height="24" Text="위로"><Publish Event="DirectoryListUp" Value="0"/></Control>
        <Control Id="NewFolder" Type="PushButton" X="356" Y="80" Width="76" Height="24" Text="새 폴더"><Publish Event="DirectoryListNew" Value="0"/></Control>
        <Control Id="Folders" Type="DirectoryList" X="28" Y="114" Width="404" Height="126" Property="INSTALLFOLDER" Sunken="yes" TabSkip="no"/>
        <Control Id="PathLabel" Type="Text" X="28" Y="252" Width="404" Height="14" TabSkip="no" Text="선택한 설치 경로"/>
        <Control Id="Path" Type="PathEdit" X="28" Y="274" Width="404" Height="22" Property="INSTALLFOLDER"/>
        <Control Id="FooterLine" Type="Line" X="28" Y="316" Width="404" Height="1"/>
        <Control Id="UseFolder" Type="PushButton" X="248" Y="330" Width="88" Height="26" Default="yes" Text="선택">
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1"/>
          <Publish Event="EndDialog" Value="Return" Order="2"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="344" Y="330" Width="88" Height="26" Cancel="yes" Text="취소"><Publish Event="Reset" Value="0" Order="1"/><Publish Event="EndDialog" Value="Return" Order="2"/></Control>
      </Dialog>
      <Dialog Id="InstallerError" Width="420" Height="200" Title="Excel 암호 관리 $(var.DisplayVersion)" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="24" Y="22" Width="372" Height="112" TabSkip="no" NoPrefix="yes" Text="설치 경로와 접근 권한을 확인하세요."/>
        <Control Id="Abort" Type="PushButton" X="132" Y="154" Width="76" Height="26" TabSkip="yes" Text="중단"><Publish Event="EndDialog" Value="ErrorAbort"/></Control>
        <Control Id="Cancel" Type="PushButton" X="132" Y="154" Width="76" Height="26" TabSkip="yes" Text="취소"><Publish Event="EndDialog" Value="ErrorCancel"/></Control>
        <Control Id="Ignore" Type="PushButton" X="132" Y="154" Width="76" Height="26" TabSkip="yes" Text="건너뛰기"><Publish Event="EndDialog" Value="ErrorIgnore"/></Control>
        <Control Id="No" Type="PushButton" X="132" Y="154" Width="76" Height="26" TabSkip="yes" Text="아니요"><Publish Event="EndDialog" Value="ErrorNo"/></Control>
        <Control Id="OK" Type="PushButton" X="132" Y="154" Width="76" Height="26" TabSkip="yes" Text="확인"><Publish Event="EndDialog" Value="ErrorOk"/></Control>
        <Control Id="Retry" Type="PushButton" X="132" Y="154" Width="76" Height="26" TabSkip="yes" Text="다시 시도"><Publish Event="EndDialog" Value="ErrorRetry"/></Control>
        <Control Id="Yes" Type="PushButton" X="132" Y="154" Width="76" Height="26" TabSkip="yes" Text="예"><Publish Event="EndDialog" Value="ErrorYes"/></Control>
      </Dialog>
      <Dialog Id="Progress" Width="460" Height="230" Title="Excel 암호 관리 작업 중" Modeless="yes">
        <Control Id="Brand" Type="Text" X="28" Y="20" Width="400" Height="16" Text="{\BrandFont}ExcelPasswordSafe $(var.DisplayVersion)"/>
        <Control Id="Title" Type="Text" X="28" Y="43" Width="400" Height="34" TabSkip="no" Text="{\TitleFont}잠시 기다려 주세요"/>
        <Control Id="HeaderLine" Type="Line" X="28" Y="95" Width="404" Height="1"/>
        <Control Id="Action" Type="Text" X="28" Y="114" Width="400" Height="42"><Subscribe Event="ActionText" Attribute="Text"/></Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="28" Y="170" Width="404" Height="16" ProgressBlocks="yes"><Subscribe Event="SetProgress" Attribute="Progress"/></Control>
      </Dialog>
      <Dialog Id="Maintenance" Width="460" Height="286" Title="Excel 암호 관리 복구 또는 제거">
        <Control Id="Brand" Type="Text" X="28" Y="20" Width="400" Height="16" Text="{\BrandFont}ExcelPasswordSafe $(var.DisplayVersion)"/>
        <Control Id="Title" Type="Text" X="28" Y="43" Width="400" Height="34" Text="{\TitleFont}복구 또는 제거"/>
        <Control Id="HeaderLine" Type="Line" X="28" Y="95" Width="404" Height="1"/>
        <Control Id="Body" Type="Text" X="28" Y="114" Width="400" Height="93" Text="프로그램 복구&#13;&#10;프로그램 파일과 탐색기 메뉴를 다시 설치합니다.&#13;&#10;&#13;&#10;프로그램 제거&#13;&#10;프로그램과 메뉴를 지웁니다. Excel 파일·백업·복구 기록은 보존합니다."/>
        <Control Id="FooterLine" Type="Line" X="28" Y="232" Width="404" Height="1"/>
        <Control Id="Repair" Type="PushButton" X="126" Y="246" Width="96" Height="26" Default="yes" Text="프로그램 복구"><Publish Property="REINSTALL" Value="ALL"/><Publish Property="REINSTALLMODE" Value="amus"/><Publish Event="EndDialog" Value="Return"/></Control>
        <Control Id="Remove" Type="PushButton" X="230" Y="246" Width="96" Height="26" Text="프로그램 제거"><Publish Property="REMOVE" Value="ALL"/><Publish Event="EndDialog" Value="Return"/></Control>
        <Control Id="Cancel" Type="PushButton" X="334" Y="246" Width="98" Height="26" Cancel="yes" Text="취소"><Publish Event="EndDialog" Value="Exit"/></Control>
      </Dialog>
      <Dialog Id="Complete" Width="460" Height="286" Title="Excel 암호 관리">
        <Control Id="Brand" Type="Text" X="28" Y="20" Width="400" Height="16" Text="{\BrandFont}ExcelPasswordSafe $(var.DisplayVersion)"/>
        <Control Id="Title" Type="Text" X="28" Y="43" Width="400" Height="34" Text="{\TitleFont}작업을 마쳤습니다"/>
        <Control Id="HeaderLine" Type="Line" X="28" Y="95" Width="404" Height="1"/>
        <Control Id="Body" Type="Text" X="28" Y="114" Width="400" Height="93" Text="설치·복구 후 Excel 파일·폴더 또는 폴더의 빈 공간을 오른쪽 클릭하세요.&#13;&#10;Windows 11: 더 많은 옵션 표시 → Excel 암호 관리&#13;&#10;파일·폴더·빈 공간에서 암호 설정·해제·변경을 바로 고릅니다.&#13;&#10;&#13;&#10;제거해도 Excel 파일과 백업, 복구 기록은 남아 있습니다."/>
        <Control Id="FooterLine" Type="Line" X="28" Y="232" Width="404" Height="1"/>
        <Control Id="Close" Type="PushButton" X="344" Y="246" Width="88" Height="26" Default="yes" Cancel="yes" Text="닫기"><Publish Event="EndDialog" Value="Return"/></Control>
      </Dialog>
      <InstallUISequence><Show Dialog="Welcome" Before="Maintenance" Condition="NOT Installed"/><Show Dialog="Maintenance" Before="Progress" Condition="Installed AND NOT REMOVE AND NOT REINSTALL"/><Show Dialog="Progress" Before="ExecuteAction"/><Show Dialog="Complete" OnExit="success"/></InstallUISequence>
    </UI>
  </Package>
</Wix>
