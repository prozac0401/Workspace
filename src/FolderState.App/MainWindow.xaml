<Window x:Class="FolderState.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FolderState · 업무 상태" Width="960" Height="740" MinWidth="760" MinHeight="680" Background="#F3F6FA" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic">
 <Grid Background="#F3F6FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#14283F" Padding="26,32"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="F / S" FontSize="30" FontWeight="Bold" Foreground="#7CE0D1"/><TextBlock Text="FolderState" FontSize="23" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,8"/><TextBlock Text="업무 상태 도구" Foreground="#BDCBDB" FontSize="13"/><Border Height="1" Background="#35485E" Margin="0,30,0,24"/><TextBlock Text="01   폴더 상태" Foreground="White" FontWeight="SemiBold" FontSize="15"/></StackPanel>
   <StackPanel VerticalAlignment="Bottom"><TextBlock Text="폴더는 그대로.&#x0a;진행 상황은 한눈에." Foreground="#BDCBDB" FontSize="14" LineHeight="24"/><TextBlock x:Name="VersionText" Foreground="#92A7BD" FontSize="11" Margin="0,18,0,0"/></StackPanel>
  </DockPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,32,32,28">
   <TextBlock Text="업무의 현재 상태를 표시하세요" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="선택한 폴더의 아이콘에 상태를 표시합니다." FontSize="14" Foreground="#53667D" Margin="0,10,0,26"/>
   <Border Background="White" BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="12" Padding="24"><StackPanel>
    <TextBlock Text="대상 폴더" FontSize="12" FontWeight="Bold" Foreground="#53667D" Margin="0,0,0,12"/>
    <DockPanel><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="폴더 선택" Click="Browse_Click" Margin="12,0,0,0" AutomationProperties.Name="대상 폴더 선택"/><TextBox x:Name="FolderPath" FontSize="14" VerticalContentAlignment="Center" Padding="10" BorderBrush="#CBD5E1" BorderThickness="1" ToolTip="전체 폴더 경로 입력 후 Enter" KeyDown="Path_KeyDown" AutomationProperties.Name="대상 폴더 전체 경로"/></DockPanel>
    <TextBlock x:Name="CurrentState" Text="폴더를 선택하면 현재 상태가 표시됩니다." Margin="0,14,0,0" FontSize="13" Foreground="#53667D"/>
   </StackPanel></Border>
   <TextBlock Text="상태 지정" FontWeight="SemiBold" FontSize="16" Margin="0,26,0,14"/>
   <UniformGrid x:Name="StateButtons" Rows="1" IsEnabled="False">
    <Button Tag="Todo" Click="State_Click" Margin="0,0,8,0" Padding="8,20" AutomationProperties.Name="미착수 상태로 변경"><StackPanel><Image x:Name="todoImage" Width="48" Height="48"/><TextBlock Text="미착수" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Button>
    <Button Tag="Doing" Click="State_Click" Margin="0,0,8,0" Padding="8,20" AutomationProperties.Name="진행 중 상태로 변경"><StackPanel><Image x:Name="doingImage" Width="48" Height="48"/><TextBlock Text="진행 중" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Button>
    <Button Tag="Done" Click="State_Click" Margin="0,0,8,0" Padding="8,20" AutomationProperties.Name="완료 상태로 변경"><StackPanel><Image x:Name="doneImage" Width="48" Height="48"/><TextBlock Text="완료" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Button>
    <Button Tag="Issue" Click="State_Click" Padding="8,20" AutomationProperties.Name="이슈 상태로 변경"><StackPanel><Image x:Name="issueImage" Width="48" Height="48"/><TextBlock Text="이슈" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Button>
   </UniformGrid>
   <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><TextBlock Text="아이콘 저장" VerticalAlignment="Center" Margin="0,0,18,0" FontSize="13"/><RadioButton x:Name="LocalMode" Content="이 PC (기본)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,22,0"/><RadioButton x:Name="PortableMode" Content="폴더와 함께 이동" VerticalAlignment="Center" ToolTip="폴더 안에 아이콘을 함께 저장합니다. 다른 PC의 정책에 따라 표시가 달라질 수 있습니다."/></StackPanel>
   <DockPanel Margin="0,24,0,0"><Button x:Name="RepairButton" Content="상태 아이콘 복구" IsEnabled="False" Click="Repair_Click" Margin="0,0,10,0"/><Button x:Name="ResetButton" Content="상태 초기화" IsEnabled="False" Click="Reset_Click"/><TextBlock/></DockPanel>
   <Border Background="#E8F3F3" CornerRadius="8" Padding="16" Margin="0,22,0,0"><TextBlock x:Name="ResultText" Text="탐색기에서 폴더 우클릭 → 더 많은 옵션 표시 → 업무 상태를 사용할 수 있습니다." FontSize="13" LineHeight="21" AutomationProperties.LiveSetting="Polite"/></Border>
   <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="사용 안내" Click="Help_Click" Padding="12,8" FontSize="12" Margin="0,0,8,0"/><Button Content="로컬 로그 열기" Click="Logs_Click" Padding="12,8" FontSize="12"/></StackPanel>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
