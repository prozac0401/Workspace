<Window x:Class="FolderState.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FolderState · 폴더에 진행 상황 표시" Width="900" Height="780" MinWidth="760" MinHeight="560" Background="#F3F6FA" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic">
 <ScrollViewer Background="#F3F6FA" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,20,28,24">
   <DockPanel Margin="0,0,0,16">
    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock Text="FolderState" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="VersionText" Foreground="#53667D" FontSize="12" HorizontalAlignment="Right"/></StackPanel>
    <StackPanel><TextBlock Text="폴더에 진행 상황을 표시하세요" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="폴더를 확인하고, 현재 업무 상태를 누르세요. 폴더 이름과 업무 파일은 그대로입니다." FontSize="13" Foreground="#53667D" Margin="0,6,18,0"/></StackPanel>
   </DockPanel>
   <Border Background="White" BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="12" Padding="18">
    <StackPanel>
     <TextBlock Text="1. 적용할 폴더를 확인하세요" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <DockPanel>
      <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="폴더 선택" Click="Browse_Click" Margin="8,0,0,0" Padding="14,10" AutomationProperties.Name="진행 상황을 표시할 폴더 선택"/>
      <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Content="폴더 확인" Click="Confirm_Click" Margin="8,0,0,0" Padding="14,10" ToolTip="입력한 폴더의 현재 상태를 다시 읽습니다. 상태를 바꾸지 않습니다."/>
      <TextBox x:Name="FolderPath" FontSize="14" VerticalContentAlignment="Center" Padding="10" BorderBrush="#CBD5E1" BorderThickness="1" KeyDown="Path_KeyDown" TextChanged="Path_TextChanged" AutomationProperties.Name="폴더의 전체 경로" AutomationProperties.HelpText="경로를 입력한 뒤 폴더 확인 버튼이나 Enter를 누르세요."/>
     </DockPanel>
     <TextBlock x:Name="SelectedFolderText" Text="확인된 폴더가 없습니다." FontSize="14" FontWeight="SemiBold" Margin="0,12,0,5"/>
     <TextBlock x:Name="CurrentState" Text="폴더를 선택하거나 입력한 경로를 확인하세요." FontSize="18" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
     <WrapPanel Margin="0,6,0,0"><TextBlock x:Name="TimestampText" FontSize="12" Foreground="#53667D" Margin="0,0,20,0"/><TextBlock x:Name="ModeSummary" FontSize="12" Foreground="#53667D"/></WrapPanel>
    </StackPanel>
   </Border>
   <DockPanel Margin="0,18,0,10"><TextBlock Text="2. 현재 업무 상태를 누르세요" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="한 번 누르면 바로 저장됩니다." FontSize="12" Foreground="#53667D" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
   <UniformGrid x:Name="StateButtons" Rows="1" IsEnabled="False">
    <Button Tag="Todo" Click="State_Click" Margin="0,0,8,0" Padding="8,10" AutomationProperties.Name="시작 전으로 저장" ToolTip="아직 일을 시작하지 않았습니다."><StackPanel><Image x:Name="todoImage" Width="40" Height="40"/><TextBlock Text="시작 전" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="아직 시작 안 함" FontSize="11" Foreground="#53667D" TextAlignment="Center" Margin="0,3,0,0"/><TextBlock Text="현재 저장된 상태" FontSize="11" Foreground="#066873" TextAlignment="Center" Margin="0,5,0,0" Visibility="Hidden"/></StackPanel></Button>
    <Button Tag="Doing" Click="State_Click" Margin="0,0,8,0" Padding="8,10" AutomationProperties.Name="진행 중으로 저장" ToolTip="일을 하고 있거나 예정된 답변을 기다리고 있습니다."><StackPanel><Image x:Name="doingImage" Width="40" Height="40"/><TextBlock Text="진행 중" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="하고 있는 일" FontSize="11" Foreground="#53667D" TextAlignment="Center" Margin="0,3,0,0"/><TextBlock Text="현재 저장된 상태" FontSize="11" Foreground="#066873" TextAlignment="Center" Margin="0,5,0,0" Visibility="Hidden"/></StackPanel></Button>
    <Button Tag="Done" Click="State_Click" Margin="0,0,8,0" Padding="8,10" AutomationProperties.Name="완료로 저장" ToolTip="필요한 결과물과 승인·전달을 확인한 뒤 선택하세요. 프로그램이 완료 여부를 확인하지는 않습니다."><StackPanel><Image x:Name="doneImage" Width="40" Height="40"/><TextBlock Text="완료" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="끝낸 일" FontSize="11" Foreground="#53667D" TextAlignment="Center" Margin="0,3,0,0"/><TextBlock Text="현재 저장된 상태" FontSize="11" Foreground="#066873" TextAlignment="Center" Margin="0,5,0,0" Visibility="Hidden"/></StackPanel></Button>
    <Button Tag="Issue" Click="State_Click" Padding="8,10" AutomationProperties.Name="확인 필요로 저장" ToolTip="문제가 있거나 확인·결정이 필요합니다."><StackPanel><Image x:Name="issueImage" Width="40" Height="40"/><TextBlock Text="확인 필요" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="문제·결정 대기" FontSize="11" Foreground="#53667D" TextAlignment="Center" Margin="0,3,0,0"/><TextBlock Text="현재 저장된 상태" FontSize="11" Foreground="#066873" TextAlignment="Center" Margin="0,5,0,0" Visibility="Hidden"/></StackPanel></Button>
   </UniformGrid>
   <Border x:Name="ResultPanel" Background="#EAF0F6" CornerRadius="8" Padding="14" Margin="0,14,0,0">
    <StackPanel><TextBlock x:Name="ResultTitle" Text="폴더를 선택해 시작하세요" FontSize="14" FontWeight="SemiBold" Foreground="#304B68"/><TextBlock x:Name="ResultText" Text="탐색기에서도 폴더 오른쪽 클릭 → 더 많은 옵션 표시 → 업무 상태로 바꿀 수 있습니다." FontSize="13" LineHeight="20" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   </Border>
   <WrapPanel Margin="0,12,0,0">
    <Button x:Name="OpenFolderButton" Content="탐색기에서 보기" Click="OpenFolder_Click" Padding="12,9" Margin="0,0,8,8" FontSize="13" IsEnabled="False" ToolTip="확인한 폴더를 탐색기에서 엽니다."/>
    <Button x:Name="RepairButton" Content="아이콘 다시 표시" IsEnabled="False" Click="Repair_Click" Padding="12,9" Margin="0,0,8,8" FontSize="13" ToolTip="상태와 변경 시각을 유지하면서 아이콘을 다시 설정합니다. 중단된 작업이 있으면 먼저 복구합니다."/>
    <Button Content="문제 해결 안내" Click="Troubleshooting_Click" Padding="12,9" Margin="0,0,8,8" FontSize="13"/>
   </WrapPanel>
   <Expander Header="아이콘 저장 위치 바꾸기 (선택)" FontSize="13" Margin="0,6,0,0">
    <StackPanel Margin="20,10,0,10">
     <WrapPanel><RadioButton x:Name="LocalMode" Content="이 PC (기본)" IsChecked="True" Checked="Mode_Checked" Margin="0,0,22,10"/><RadioButton x:Name="PortableMode" Content="선택한 폴더 안" Checked="Mode_Checked" Margin="0,0,0,10" ToolTip="아이콘을 폴더와 함께 복사할 수 있습니다. 다른 PC에서는 표시가 달라질 수 있습니다."/></WrapPanel>
     <TextBlock x:Name="ModeHint" Foreground="#53667D" LineHeight="20"/>
     <Button x:Name="ModeApplyButton" Content="아이콘 저장 위치 적용" Click="ModeApply_Click" HorizontalAlignment="Left" Padding="12,8" FontSize="13" Margin="0,10,0,0" IsEnabled="False"/>
    </StackPanel>
   </Expander>
   <Expander Header="이 폴더의 상태 표시 지우기" FontSize="13" Margin="0,10,0,0">
    <StackPanel Margin="20,10,0,10"><TextBlock Text="저장된 상태를 지우고 이전 아이콘 설정으로 되돌립니다. ‘시작 전’으로 바꾸는 기능과 다릅니다. FolderState 밖에서 바꾼 설정과 업무 파일은 그대로 둡니다." Foreground="#53667D" LineHeight="20"/><Button x:Name="ResetButton" Content="상태 표시 지우기" IsEnabled="False" Click="Reset_Click" HorizontalAlignment="Left" Padding="12,8" FontSize="13" Margin="0,10,0,0"/></StackPanel>
   </Expander>
   <WrapPanel Margin="0,16,0,0"><Button Content="사용 안내" Click="Help_Click" Padding="12,8" FontSize="12" Margin="0,0,8,0"/><Button Content="작업 기록 열기" Click="Logs_Click" Padding="12,8" FontSize="12" ToolTip="이 PC에 저장된 성공·실패 기록이 있는 폴더를 엽니다."/></WrapPanel>
  </StackPanel>
 </ScrollViewer>
</Window>
