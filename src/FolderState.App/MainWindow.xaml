<Window x:Class="FolderState.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FolderState · 폴더에 진행 상황 표시" Width="960" Height="740" MinWidth="760" MinHeight="680" Background="#F3F6FA" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic">
 <Grid Background="#F3F6FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#14283F" Padding="26,32"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="F / S" FontSize="30" FontWeight="Bold" Foreground="#7CE0D1"/><TextBlock Text="FolderState" FontSize="23" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,8"/><TextBlock Text="폴더에 진행 상황 표시" Foreground="#BDCBDB" FontSize="13"/><Border Height="1" Background="#35485E" Margin="0,30,0,24"/><TextBlock Text="폴더 상태 바꾸기" Foreground="White" FontWeight="SemiBold" FontSize="15"/></StackPanel>
   <StackPanel VerticalAlignment="Bottom"><TextBlock Text="폴더와 파일은 그대로.&#x0a;진행 상황은 아이콘으로." Foreground="#BDCBDB" FontSize="14" LineHeight="24"/><TextBlock x:Name="VersionText" Foreground="#92A7BD" FontSize="11" Margin="0,18,0,0"/></StackPanel>
  </DockPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,32,32,28">
   <TextBlock Text="폴더에 진행 상황을 표시하세요" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="폴더 하나를 고르고, 현재 상태를 누르면 됩니다." FontSize="14" Foreground="#53667D" Margin="0,10,0,22"/>
   <Border Background="White" BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="12" Padding="24"><StackPanel>
    <TextBlock Text="1. 폴더를 고르세요" FontSize="14" FontWeight="SemiBold" Foreground="#53667D" Margin="0,0,0,12"/>
    <DockPanel><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="폴더 선택" Click="Browse_Click" Margin="12,0,0,0" AutomationProperties.Name="진행 상황을 표시할 폴더 선택"/><TextBox x:Name="FolderPath" FontSize="14" VerticalContentAlignment="Center" Padding="10" BorderBrush="#CBD5E1" BorderThickness="1" ToolTip="폴더 경로를 붙여 넣어도 됩니다. 입력한 뒤 Enter를 누르세요." KeyDown="Path_KeyDown" AutomationProperties.Name="폴더의 전체 경로" AutomationProperties.HelpText="폴더 선택 버튼을 누르거나 전체 경로를 입력한 뒤 Enter를 누르세요."/></DockPanel>
    <TextBlock x:Name="CurrentState" Text="폴더를 고르면 저장된 상태가 여기에 보입니다." Margin="0,14,0,0" FontSize="13" Foreground="#53667D" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel></Border>
   <Expander Header="아이콘 저장 위치 바꾸기 (선택)" FontSize="13" Margin="0,16,0,0">
    <StackPanel Margin="20,10,0,0">
     <WrapPanel><RadioButton x:Name="LocalMode" Content="이 PC (기본)" IsChecked="True" Margin="0,0,22,8" ToolTip="이 PC에 설치된 아이콘을 사용합니다."/><RadioButton x:Name="PortableMode" Content="선택한 폴더 안" Margin="0,0,0,8" ToolTip="폴더 안에 아이콘을 저장해 폴더와 함께 복사할 수 있습니다. 다른 PC에서는 표시가 달라질 수 있습니다."/></WrapPanel>
     <TextBlock Text="다른 PC로 폴더를 옮길 때는 ‘선택한 폴더 안’을 고를 수 있습니다. 위치를 고른 뒤 아래 상태 버튼을 누르면 저장됩니다." Foreground="#53667D" LineHeight="20"/>
    </StackPanel>
   </Expander>
   <TextBlock Text="2. 현재 상태를 누르세요" FontWeight="SemiBold" FontSize="16" Margin="0,22,0,4"/>
   <TextBlock Text="버튼을 누르면 바로 저장됩니다." FontSize="13" Foreground="#53667D" Margin="0,0,0,12"/>
   <UniformGrid x:Name="StateButtons" Rows="1" IsEnabled="False">
    <Button Tag="Todo" Click="State_Click" Margin="0,0,8,0" Padding="8,16" AutomationProperties.Name="시작 전으로 저장" ToolTip="아직 일을 시작하지 않았습니다."><StackPanel><Image x:Name="todoImage" Width="48" Height="48"/><TextBlock Text="시작 전" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="아직 시작 안 함" FontSize="11" Foreground="#53667D" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
    <Button Tag="Doing" Click="State_Click" Margin="0,0,8,0" Padding="8,16" AutomationProperties.Name="진행 중으로 저장" ToolTip="일을 하고 있거나 예정된 답변을 기다리고 있습니다."><StackPanel><Image x:Name="doingImage" Width="48" Height="48"/><TextBlock Text="진행 중" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="하고 있는 일" FontSize="11" Foreground="#53667D" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
    <Button Tag="Done" Click="State_Click" Margin="0,0,8,0" Padding="8,16" AutomationProperties.Name="완료로 저장" ToolTip="필요한 결과물과 승인·전달을 확인한 뒤 선택하세요. 프로그램이 완료 여부를 확인하지는 않습니다."><StackPanel><Image x:Name="doneImage" Width="48" Height="48"/><TextBlock Text="완료" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="끝낸 일" FontSize="11" Foreground="#53667D" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
    <Button Tag="Issue" Click="State_Click" Padding="8,16" AutomationProperties.Name="확인 필요로 저장" ToolTip="문제가 있거나 확인·결정이 필요합니다."><StackPanel><Image x:Name="issueImage" Width="48" Height="48"/><TextBlock Text="확인 필요" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="문제·결정 대기" FontSize="11" Foreground="#53667D" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
   </UniformGrid>
   <WrapPanel Margin="0,18,0,0"><Button x:Name="RepairButton" Content="아이콘 다시 표시" IsEnabled="False" Click="Repair_Click" Margin="0,0,10,0" ToolTip="저장된 상태의 아이콘을 다시 설정합니다. 상태와 변경 시각은 그대로입니다." AutomationProperties.HelpText="상태는 저장되어 있는데 아이콘이 안 보일 때 누르세요."/><Button x:Name="ResetButton" Content="상태 표시 지우기" IsEnabled="False" Click="Reset_Click" ToolTip="저장된 상태를 지우고 이전 아이콘 설정으로 되돌립니다. FolderState 밖에서 바꾼 설정은 그대로 둡니다. ‘시작 전’으로 바꾸는 기능과 다릅니다." AutomationProperties.HelpText="이 폴더에 저장한 상태 표시를 지웁니다. 폴더 이름과 업무 파일은 그대로입니다."/></WrapPanel>
   <Border Background="#E8F3F3" CornerRadius="8" Padding="16" Margin="0,18,0,0"><TextBlock x:Name="ResultText" Text="탐색기에서도 바꿀 수 있습니다.&#x0a;폴더 오른쪽 클릭 → 더 많은 옵션 표시 → 업무 상태" FontSize="13" LineHeight="21" AutomationProperties.LiveSetting="Polite"/></Border>
   <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="사용 안내" Click="Help_Click" Padding="12,8" FontSize="12" Margin="0,0,8,0"/><Button Content="작업 기록 열기" Click="Logs_Click" Padding="12,8" FontSize="12" ToolTip="이 PC에 저장된 성공·실패 기록이 있는 폴더를 엽니다."/></StackPanel>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
